# Shell scripts must stay LF even when checked out
# on Windows with core.autocrlf=true. CRLF in a
# shebang line (#!/bin/sh\r) silently breaks the
# interpreter.
*.sh             text eol=lf
bin/jolitz-*    text eol=lf
.claude/hooks/*  text eol=lf
# The start screens go out as JSON by .claude/hooks/banner.sh;
# keep them byte for byte the same on every platform.
assets/*.txt     text eol=lf
# Test fixtures are compared line by line.
tests/fixtures/* text eol=lf
# CLAUDE.md is one import line; a CR after @AGENTS.md would
# name another file. The rules file stays LF with it.
CLAUDE.md        text eol=lf
AGENTS.md        text eol=lf
