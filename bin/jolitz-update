#!/bin/sh
# jolitz-update — update, pin, or check jolitz version.
#
# Usage:
#   jolitz-update            Pull latest from main
#   jolitz-update --check    Show current version and
#                             check for updates
#   jolitz-update --pin VER  Pin to a version tag
#                             (e.g. --pin v0.1.0)
#   jolitz-update --unpin    Return to main and pull
set -e

# Find the repo root (this script lives in bin/).
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"

current_version() {
  if [ -f VERSION ]; then
    cat VERSION
  else
    echo "unknown"
  fi
}

show_changelog_section() {
  VER="$1"
  # Match the version heading exactly ("## 2.8.0"
  # must not also match "## 2.8.0-rc1"): compare
  # the whole second field, not a prefix.
  if [ -f CHANGELOG.md ]; then
    awk -v ver="$VER" '
      /^## / { if (insec) exit; insec = ($2 == ver); next }
      insec && NF { print }
    ' CHANGELOG.md
  fi
}

case "${1:-}" in
  --check)
    echo "jolitz $(current_version)"
    BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)
    if [ -z "$BRANCH" ]; then
      TAG=$(git describe --tags --exact-match 2>/dev/null || true)
      if [ -n "$TAG" ]; then
        echo "Pinned to $TAG"
      else
        echo "On detached HEAD"
      fi
      exit 0
    fi
    if [ "$BRANCH" != "main" ]; then
      echo "On branch '$BRANCH' (not main)"
      exit 0
    fi
    git fetch --quiet origin main
    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse origin/main)
    if [ "$LOCAL" = "$REMOTE" ]; then
      echo "Up to date."
    else
      AHEAD=$(git rev-list --count origin/main..HEAD)
      BEHIND=$(git rev-list --count HEAD..origin/main)
      [ "$BEHIND" -gt 0 ] && echo "$BEHIND commit(s) behind origin/main."
      [ "$AHEAD" -gt 0 ] && echo "$AHEAD commit(s) ahead of origin/main."
    fi
    ;;

  --pin)
    VER="${2:?Usage: jolitz-update --pin VERSION (e.g. v2.0.0)}"
    # Fresh/shallow clones may not have tags yet.
    # Fetch them before checking so --pin can reach
    # remote-only tags.
    git fetch --tags --quiet 2>/dev/null || true
    if ! git rev-parse "$VER" >/dev/null 2>&1; then
      echo "Error: tag '$VER' not found."
      echo "Available tags:"
      git tag --sort=-v:refname | head -10
      exit 1
    fi
    git checkout "$VER"
    echo "jolitz pinned to $VER ($(current_version))"
    echo "Auto-update is disabled while pinned."
    echo "Run 'jolitz-update --unpin' to return to main."
    ;;

  --unpin)
    git checkout main
    git pull --ff-only --quiet
    echo "jolitz unpinned — now on main ($(current_version))"
    ;;

  --help|-h)
    echo "Usage: jolitz-update [--check|--pin VER|--unpin]"
    echo ""
    echo "  (no args)   Pull latest from main"
    echo "  --check     Show version and update status"
    echo "  --pin VER   Pin to a version tag (e.g. v0.1.0)"
    echo "  --unpin     Return to main and pull latest"
    ;;

  "")
    # Default: pull latest.
    BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)
    if [ -z "$BRANCH" ]; then
      echo "Error: not on a branch. Use --unpin first."
      exit 1
    fi
    if [ "$BRANCH" != "main" ]; then
      echo "Error: on branch '$BRANCH', not main."
      echo "Switch to main first or use --unpin."
      exit 1
    fi

    OLD_VERSION=$(current_version)
    OLD_HEAD=$(git rev-parse HEAD)
    # --ff-only: never create a silent merge commit
    # on a diverged main. Capture the failure so
    # set -e doesn't kill us with a raw git error.
    if ! OUTPUT=$(git pull --ff-only --quiet 2>&1); then
      echo "jolitz update failed: $OUTPUT"
      echo "Likely causes: local changes (run 'git status',"
      echo "stash them with 'git stash'), local commits on a"
      echo "diverged main, or no network. Fix and re-run."
      exit 1
    fi
    NEW_VERSION=$(current_version)
    NEW_HEAD=$(git rev-parse HEAD)

    # Run the 1.x → 2.0 migration if needed.
    # Idempotent and silent when there's nothing
    # to do.
    [ -f bin/jolitz-migrate ] && sh bin/jolitz-migrate

    # Every new commit is named, whether or not
    # VERSION moved: a pull brings rules, hooks and
    # scripts that run from now on.
    if [ "$OLD_HEAD" != "$NEW_HEAD" ]; then
      echo "jolitz repo updated: $(git rev-parse --short "$OLD_HEAD")..$(git rev-parse --short "$NEW_HEAD")"
      git log --oneline "$OLD_HEAD..$NEW_HEAD" | sed 's/^/  /'
    fi
    if [ "$OLD_HEAD" = "$NEW_HEAD" ]; then
      echo "jolitz $(current_version) — already up to date."
    elif [ "$OLD_VERSION" = "$NEW_VERSION" ]; then
      echo "jolitz $(current_version) — same version, new commits above."
    else
      echo "jolitz updated: $OLD_VERSION -> $NEW_VERSION"
      show_changelog_section "$NEW_VERSION"
    fi
    ;;

  *)
    echo "Unknown option: $1"
    echo "Run 'jolitz-update --help' for usage."
    exit 1
    ;;
esac
