#!/bin/sh
# jolitz-doctor — check the workstation jolitz runs on:
# Claude Code version, guard hooks, tools, cache, git
# state, memory, logs, ssh agent, team hub. Reads local
# files only; never connects to a server. Only --fetch
# goes online, to the git remote of this checkout, and
# the hub line, to the hub in ~/.config/jolitz/hub.conf
# when that file exists.
#
# Usage:
#   jolitz-doctor                Run every check
#   jolitz-doctor --strict       Warnings fail too
#   jolitz-doctor --fetch        git fetch first, then
#                                 compare main with
#                                 origin/main
#   jolitz-doctor -d <dir>       Use <dir> as memory/
#   jolitz-doctor --help         Show this help
#
# One line per check: OK, WARN or FAIL padded to six
# columns, then "<check>: <detail>". A missing tool
# fails its own line; the run continues.
#
# FAIL: claude missing or older than 2.1.295, jq
# missing, memory lint errors.
# WARN: a guard hook not registered or without
# "onFailure": "block", curl missing, ~/.cache/jolitz
# missing or not mode 700, a branch other than main
# or a pinned tag, main behind origin (--fetch),
# uncommitted changes in tracked files, no
# memory/user.md, lint warnings, EOL cache older
# than 30 days, guard.log or ~/jolitz-cron.log over
# 10 MB, ssh agent without a key, the hub unreachable
# or rejecting the token (bin/jolitz-sync status).
#
# Exit status: 0 all OK, 1 warnings with --strict,
# 2 any FAIL or a usage error.
set -e

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
SELF="$SCRIPT_DIR/$(basename "$0")"

usage() {
  awk '/^# jolitz-doctor/{in_help=1} in_help{if(/^[^#]/)exit; sub(/^# ?/,""); print}' "$SELF"
}

MEM="$REPO_DIR/memory"
STRICT=0
FETCH=0
while [ $# -gt 0 ]; do
  case "$1" in
    --strict) STRICT=1 ;;
    --fetch) FETCH=1 ;;
    -d) [ $# -ge 2 ] || { usage >&2; exit 2; }
        MEM=$2; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "error: unknown option $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

MIN_CLAUDE=2.1.295
FAILS=0
WARNS=0

ok()   { echo "OK    $1"; }
warn() { echo "WARN  $1"; WARNS=$((WARNS + 1)); }
fail() { echo "FAIL  $1"; FAILS=$((FAILS + 1)); }

# vercmp <a> <b>: prints -1, 0 or 1 comparing X.Y.Z
# numerically per component. Missing components count
# as 0; a suffix after the third number is ignored.
vercmp() {
  printf '%s\n%s\n' "$1" "$2" | awk -F. '
    { for (i = 1; i <= 3; i++) v[NR, i] = $i + 0 }
    END {
      for (i = 1; i <= 3; i++) {
        if (v[1, i] < v[2, i]) { print -1; exit }
        if (v[1, i] > v[2, i]) { print 1; exit }
      }
      print 0
    }'
}

# days_since <YYYY-MM-DD>: whole days from that date to
# today, or -1 if the date does not parse. Civil-day
# arithmetic in awk; no date -d / date -j needed.
days_since() {
  printf '%s\n%s\n' "$1" "$(date +%Y-%m-%d)" | awk '
    function dnum(s,   y, m, d, era, yoe, doy, doe) {
      if (s !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) return -1
      y = substr(s, 1, 4) + 0; m = substr(s, 6, 2) + 0
      d = substr(s, 9, 2) + 0
      if (m <= 2) y--
      era = int(y / 400); yoe = y - era * 400
      doy = int((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
      doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
      return era * 146097 + doe - 719468
    }
    NR == 1 { a = dnum($0) }
    NR == 2 { b = dnum($0) }
    END { if (a < 0 || b < 0) print -1; else print b - a }'
}

# --- Claude Code ---------------------------------------------
if ! command -v claude >/dev/null 2>&1; then
  fail "Claude Code: claude not in PATH"
else
  v=$(claude --version 2>/dev/null \
    | sed -n 's/^[^0-9]*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' \
    | head -n 1) || true
  if [ -z "$v" ]; then
    warn "Claude Code: version not readable from \"claude --version\""
  elif [ "$(vercmp "$v" "$MIN_CLAUDE")" -lt 0 ]; then
    fail "Claude Code $v: below minimum $MIN_CLAUDE"
  else
    ok "Claude Code $v: minimum $MIN_CLAUDE"
  fi
fi

# --- guard hooks ---------------------------------------------
HAVE_JQ=0
command -v jq >/dev/null 2>&1 && HAVE_JQ=1
SETTINGS="$REPO_DIR/.claude/settings.json"
if [ "$HAVE_JQ" -eq 0 ]; then
  warn "guard hooks: not checked, jq missing"
elif [ ! -f "$SETTINGS" ]; then
  warn "guard hooks: $SETTINGS missing"
else
  # One PreToolUse entry runs guard-taboos.sh for Bash,
  # one runs it with "file" for Edit|Write; both via
  # $CLAUDE_PROJECT_DIR and with "onFailure": "block".
  n=$(jq -r '
    def hooks(m): [.hooks.PreToolUse[]? | select(.matcher == m)
      | .hooks[]? | select(.type == "command")
      | select(.command | test("\\$CLAUDE_PROJECT_DIR/\\.claude/hooks/guard-taboos\\.sh"))
      | select(.onFailure == "block")] | length;
    (if hooks("Bash") > 0 then 1 else 0 end)
    + (if ([.hooks.PreToolUse[]? | select(.matcher | test("Edit") and test("Write"))
      | .hooks[]? | select(.type == "command")
      | select(.command | test("guard-taboos\\.sh\" file"))
      | select(.onFailure == "block")] | length) > 0 then 1 else 0 end)
    ' "$SETTINGS" 2>/dev/null) || n=""
  case "$n" in
    2) ok "guard hooks: Bash and Edit|Write registered with onFailure block" ;;
    1) warn "guard hooks: only one of Bash, Edit|Write is registered with onFailure block" ;;
    0) warn "guard hooks: none registered in .claude/settings.json" ;;
    *) warn "guard hooks: .claude/settings.json does not parse" ;;
  esac
fi

# --- tools ---------------------------------------------------
if [ "$HAVE_JQ" -eq 1 ]; then
  ok "jq: $(command -v jq)"
else
  fail "jq: not in PATH (the guard fails closed without it); install: $(sh "$REPO_DIR/lib/install-hint.sh" jq 2>/dev/null)"
fi
if command -v curl >/dev/null 2>&1; then
  ok "curl: $(command -v curl)"
else
  warn "curl: not in PATH (jolitz-overview --eol needs it)"
fi

# --- cache directory -----------------------------------------
CACHE="$HOME/.cache/jolitz"
if [ ! -d "$CACHE" ]; then
  warn "~/.cache/jolitz: missing (the SessionStart hook creates it)"
else
  # The permission string from ls -ld (POSIX, same on
  # GNU, BSD and busybox); stat differs between them.
  mode=$(ls -ld "$CACHE" 2>/dev/null | cut -c2-10) || mode=""
  if [ -z "$mode" ]; then
    warn "~/.cache/jolitz: mode not readable"
  elif [ "$mode" = "rwx------" ]; then
    ok "~/.cache/jolitz: mode 700"
  else
    warn "~/.cache/jolitz: mode $mode, want 700 (chmod 700 ~/.cache/jolitz)"
  fi
fi

# --- git state -----------------------------------------------
if ! git -C "$REPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  warn "git: $REPO_DIR is not a git checkout"
else
  branch=$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
  if [ "$branch" = "HEAD" ]; then
    tag=$(git -C "$REPO_DIR" describe --tags --exact-match 2>/dev/null) || tag=""
    if [ -n "$tag" ]; then
      warn "git: pinned to $tag (jolitz-update --unpin returns to main)"
    else
      warn "git: detached HEAD (jolitz-update --unpin returns to main)"
    fi
  elif [ "$branch" = "main" ]; then
    if [ "$FETCH" -eq 1 ]; then
      if git -C "$REPO_DIR" fetch --quiet origin 2>/dev/null; then
        behind=$(git -C "$REPO_DIR" rev-list --count HEAD..origin/main 2>/dev/null) || behind=""
        if [ -z "$behind" ]; then
          warn "git: on main, origin/main unknown"
        elif [ "$behind" -gt 0 ]; then
          warn "git: main is $behind commits behind origin/main (jolitz-update)"
        else
          ok "git: main is up to date with origin/main"
        fi
      else
        warn "git: fetch from origin failed"
      fi
    else
      ok "git: on main (not fetched; --fetch compares with origin)"
    fi
  elif [ -n "$branch" ]; then
    warn "git: on branch $branch, not main"
  else
    warn "git: branch not readable"
  fi
  dirty=$(git -C "$REPO_DIR" status --porcelain --untracked-files=no 2>/dev/null \
    | wc -l | tr -d ' ') || dirty=""
  if [ -z "$dirty" ]; then
    warn "git changes: status not readable"
  elif [ "$dirty" -gt 0 ]; then
    warn "git changes: $dirty tracked files modified (git -C $REPO_DIR status)"
  else
    ok "git changes: tracked files clean"
  fi
fi

# --- memory --------------------------------------------------
if [ -f "$MEM/user.md" ]; then
  ok "memory/user.md: present"
else
  warn "memory/user.md: missing (copy memory/user.md.example)"
fi

if [ ! -d "$MEM/servers" ]; then
  ok "memory lint: no memory/servers yet"
elif [ -x "$SCRIPT_DIR/jolitz-memory-lint" ]; then
  summary=$("$SCRIPT_DIR/jolitz-memory-lint" -d "$MEM" 2>/dev/null \
    | grep '^memory lint:' | tail -n 1) || summary=""
  errs=$(printf '%s\n' "$summary" | sed -n 's/.* \([0-9][0-9]*\) errors.*/\1/p')
  wrns=$(printf '%s\n' "$summary" | sed -n 's/.* \([0-9][0-9]*\) warnings.*/\1/p')
  if [ -z "$summary" ] || [ -z "$errs" ] || [ -z "$wrns" ]; then
    warn "memory lint: no summary from jolitz-memory-lint"
  elif [ "$errs" -gt 0 ]; then
    fail "${summary} (bin/jolitz-memory-lint)"
  elif [ "$wrns" -gt 0 ]; then
    warn "${summary} (bin/jolitz-memory-lint)"
  else
    ok "$summary"
  fi
else
  warn "memory lint: bin/jolitz-memory-lint not found"
fi

# --- team hub ------------------------------------------------
# Only when the operator joined one; otherwise not a line.
HUBCONF="$HOME/.config/jolitz/hub.conf"
if [ -r "$HUBCONF" ]; then
  if [ ! -f "$SCRIPT_DIR/jolitz-sync" ]; then
    warn "hub: bin/jolitz-sync not found"
  else
    rc=0
    out=$(sh "$SCRIPT_DIR/jolitz-sync" -d "$MEM" status --short 2>&1) || rc=$?
    out=$(printf '%s\n' "$out" | grep . | tail -n 1)
    case "$rc" in
      0) ok "hub: $out" ;;
      3) warn "hub: unreachable ($out)" ;;
      *) warn "hub: $out" ;;
    esac
  fi
fi

# --- EOL cache -----------------------------------------------
# The product whose cache is oldest: "<date> <product>",
# sorted, first line.
oldest_line=$(for f in "$MEM"/eol/*.fetched; do
    [ -f "$f" ] || continue
    printf '%s %s\n' "$(head -n 1 "$f" | tr -d ' ')" "$(basename "$f" .fetched)"
  done | sort | head -n 1)
oldest=${oldest_line%% *}
oldest_p=${oldest_line#* }
if [ -z "$oldest_line" ]; then
  ok "EOL cache: none (jolitz-overview --eol fetches it)"
else
  age=$(days_since "$oldest")
  if [ "$age" -lt 0 ]; then
    warn "EOL cache: $oldest_p fetched \"$oldest\" is not a date"
  elif [ "$age" -gt 30 ]; then
    warn "EOL cache: $oldest_p fetched $oldest, $age days ago (jolitz-overview --eol)"
  else
    ok "EOL cache: oldest $oldest_p fetched $oldest, $age days ago"
  fi
fi

# --- log sizes -----------------------------------------------
LIMIT=10485760
for f in "$CACHE/guard.log" "$HOME/jolitz-cron.log"; do
  name=${f##*/}
  if [ ! -f "$f" ]; then
    ok "$name: absent"
    continue
  fi
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -gt "$LIMIT" ]; then
    warn "$name: $((size / 1048576)) MB, over 10 MB (rotate or truncate it)"
  else
    ok "$name: $size bytes"
  fi
done

# --- ssh agent -----------------------------------------------
if ! command -v ssh-add >/dev/null 2>&1; then
  ok "ssh agent: ssh-add not installed; keys on disk still work"
else
  out=$(ssh-add -l 2>/dev/null) && rc=0 || rc=$?
  case "$rc" in
    0) ok "ssh agent: $(printf '%s\n' "$out" | grep -c .) keys loaded" ;;
    1) warn "ssh agent: no key loaded (ssh-add -l exit 1)" ;;
    2) warn "ssh agent: not running or not reachable (ssh-add -l exit 2)" ;;
    *) warn "ssh agent: ssh-add -l exit $rc" ;;
  esac
fi

[ "$FAILS" -eq 0 ] || exit 2
[ "$STRICT" -eq 0 ] || [ "$WARNS" -eq 0 ] || exit 1
exit 0
