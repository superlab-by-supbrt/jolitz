#!/bin/sh
# jolitz-migrate — bring local state up to date
# after a pull: move user state from older layouts
# (rules/custom/, a repo-root opencode.json, skill
# overrides under their old names) to the current
# one, and create the SSH socket directory.
# Idempotent: re-running on an already-migrated
# tree is a silent no-op.
#
# Called automatically by
# .claude/hooks/check-updates.sh and by
# bin/jolitz-update. Safe to run by hand.
set -e

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"

MOVED=""

# rules/custom/* → memory/custom-rules/
if [ -d rules/custom ]; then
  if find rules/custom -type f \
      ! -name '.gitkeep' -print -quit 2>/dev/null \
      | grep -q .; then
    mkdir -p memory/custom-rules
    for f in rules/custom/*; do
      [ -e "$f" ] || continue
      name=$(basename "$f")
      [ "$name" = ".gitkeep" ] && continue
      mv "$f" "memory/custom-rules/$name"
      MOVED="$MOVED\n  rules/custom/$name → memory/custom-rules/$name"
    done
  fi
fi

# opencode.json[.example] → memory/
if [ -f opencode.json ] && [ ! -e memory/opencode.json ]; then
  mv opencode.json memory/opencode.json
  MOVED="$MOVED\n  opencode.json → memory/opencode.json"
fi
if [ -f opencode.json.example ] \
    && [ ! -e memory/opencode.json.example ]; then
  mv opencode.json.example memory/opencode.json.example
  MOVED="$MOVED\n  opencode.json.example → memory/opencode.json.example"
fi

# Skill overrides follow the skills' names, which were
# heinzel-* before 3.3.3-jolitz.3. An existing jolitz-*
# file wins and the old one stays for the user to merge.
for f in memory/custom-rules/heinzel-*.md; do
  [ -e "$f" ] || continue
  new="memory/custom-rules/jolitz-${f#memory/custom-rules/heinzel-}"
  [ -e "$new" ] && continue
  mv "$f" "$new"
  MOVED="$MOVED\n  $f → $new"
done

if [ -n "$MOVED" ]; then
  printf "jolitz migration — moved user state:%b\n" "$MOVED"
  echo "Review any personal scripts or cron jobs that"
  echo "reference the old paths."
fi

# SSH connection sharing needs its socket directory
# before the first remote call
# (rules/ssh-connections.md). A SessionStart hook
# creates it as well, but the session that pulls an
# update started with the old settings, and this
# script runs from the new tree. Last, so a failure
# here cannot stop the moves above.
mkdir -p -m 700 "$HOME/.cache/jolitz" || true
