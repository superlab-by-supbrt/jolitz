# All user state lives under memory/. One checkout,
# one person: memory/ is never shared through git.

# Start by ignoring everything in memory/, then
# explicitly allow the tracked templates and keep
# markers.
memory/*
!memory/MEMORY.md
!memory/user.md.example
!memory/opencode.json.example
!memory/service-policy.md.example

# Server memory directory — keep the folder in git
# but ignore its contents.
!memory/servers/
memory/servers/*
!memory/servers/.gitkeep

# Custom rule overrides — keep the folder in git
# but ignore its contents.
!memory/custom-rules/
memory/custom-rules/*
!memory/custom-rules/.gitkeep

# Project history (auto-maintained by Claude Code).
HISTORY.md

# macOS noise.
.DS_Store

# Claude Code harness runtime artifacts (session/task locks).
# Not shipped with heinzel; created by /loop, /schedule, and
# the scheduler machinery in the Claude Code CLI.
.claude/*.lock

# Personal Claude Code permission overrides. ALWAYS personal,
# never shared — same category as memory/user.md.
#
# Claude Code appends an allow rule to this file every time you
# approve a command, so it fills up with the literal commands you
# ran, hostnames and all (e.g. an ssh line naming a production
# server). That is exactly the internal detail that must not
# reach a public repo. .claude/settings.json is the shared,
# hostname-free half; this one stays local.
.claude/settings.local.json

# Python bytecode from the scanner tests
__pycache__/
